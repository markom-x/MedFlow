# --- Supabase (client) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# --- Supabase (server) — service role, same secret as the Python .env ---
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# --- Twilio (sendDoctorMessage Server Action) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=whatsapp:+1xxxxxxxxxx
# Number shown in the "Invite patients" card (E.164, e.g. +14155238886).
# REQUIRED for the invite link/QR to render.
NEXT_PUBLIC_TWILIO_PHONE_NUMBER=+14155238886

# --- FastAPI backend (RAG record query) ---
# Public URL of the Render service in prod (e.g. https://medflow-api.onrender.com).
# On Vercel this MUST point to the deployed backend, not localhost.
MEDFLOW_API_URL=http://localhost:8000
# Token shared with the backend to authenticate /api/fascicolo/query (server-to-server).
MEDFLOW_INTERNAL_TOKEN=

# --- One-click demo login ("Enter the demo") ---
# Demo doctor account (email+password enabled in Supabase Auth for the demo only).
# The "Enter the demo" button signs in directly with these — no code required.
DEMO_DOCTOR_EMAIL=demo@medflow.health
DEMO_DOCTOR_PASSWORD=
# Practice doctor id (medici.id) used in patient activation links.
# Default = STUDIO_MEDICO_ID in lib/dashboard/constants.ts; override here if needed.
NEXT_PUBLIC_MEDICO_STUDIO_ID=
