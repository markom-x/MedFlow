# --- Supabase (client) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# --- Supabase (server) — service role, stesso segreto del .env Python ---
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# --- Twilio (Server Action sendDoctorMessage) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=whatsapp:+1xxxxxxxxxx
# Numero mostrato nella card "Invito pazienti" (E.164, es. +14155238886)
NEXT_PUBLIC_TWILIO_PHONE_NUMBER=+14155238886

# --- Backend FastAPI (interrogazione fascicolo RAG) ---
# URL pubblico del servizio Render in prod (es. https://medflow-api.onrender.com)
MEDFLOW_API_URL=http://localhost:8000
# Token condiviso col backend per autenticare /api/fascicolo/query (server-to-server)
MEDFLOW_INTERNAL_TOKEN=

# --- Login demo one-click ("Entra nella demo") ---
# Account medico demo (email+password abilitato in Supabase Auth solo per la demo).
DEMO_DOCTOR_EMAIL=demo@medflow.health
DEMO_DOCTOR_PASSWORD=
# Codice opzionale per proteggere l'accesso demo. Se vuoto, il pulsante entra diretto.
DEMO_ACCESS_PASSPHRASE=
# Id del medico dello studio (medici.id) usato nei link di attivazione paziente.
# Default = STUDIO_MEDICO_ID in lib/dashboard/constants.ts; override qui se serve.
NEXT_PUBLIC_MEDICO_STUDIO_ID=
